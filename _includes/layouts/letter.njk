---
layout: layouts/base.njk
pageType: letter
---

{# ── Content Column (rail + detail) ───────────────────── #}
<div class="content-column">
  <nav class="rail" id="rail-content" aria-label="Site navigation">
    {% include "components/rail.njk" %}
  </nav>

  <main class="detail" id="main" tabindex="-1">
    <button class="detail__tab" id="detail-tab" aria-expanded="true" aria-controls="detail-content" aria-label="Toggle post details"></button>

    {% include "components/slide-panels.njk" %}

    <div class="detail__content" id="detail-content">
      {% include "components/post-detail.njk" %}
    </div>
  </main>
</div>

{# ── Image Panel (cover image where HEHT's video panel was) ── #}
<section class="image-panel" id="image-panel" aria-label="Post cover image">
  <div class="image-panel__slide" id="image-slide"{% if cover.image %} style="background-image:url('{% lqip cover.image %}')"{% endif %}>
    {% if cover.image %}
    <img
      src="/assets/img/{{ cover.image }}"
      alt="{{ cover.alt }}"
      class="image-panel__cover"
      loading="eager"
      fetchpriority="high"
      sizes="(max-width: 1024px) 100vw, 50vw" />
    {% endif %}
  </div>

  <nav class="letter-nav" aria-label="Letter navigation">
    <button id="prev-btn" type="button" aria-label="Previous letter">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" aria-hidden="true"><line x1="2.75" y1="9" x2="15.25" y2="9" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></line><polyline points="7 13.25 2.75 9 7 4.75" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></polyline></svg>
    </button>
    <button id="next-btn" type="button" aria-label="Next letter">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" aria-hidden="true"><line x1="15.25" y1="9" x2="2.75" y2="9" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></line><polyline points="11 4.75 15.25 9 11 13.25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></polyline></svg>
    </button>
  </nav>
</section>
