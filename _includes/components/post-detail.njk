{# Post Detail — renders inside the .detail panel for letter pages.
   Adapted from HEHT's episode-detail for blog post content. #}

<article class="detail__slide" id="detail-slide">
  <header>
    <p class="detail__eyebrow">
      <span>{{ date_published | readableDate }}</span>
    </p>

    <h1 class="detail__title">{{ title }}</h1>

    <div class="detail__meta">
      <span>Joel Goodman</span>
      <svg class="icon-sep" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true"><path d="m6,12c-.414,0-.75-.336-.75-.75V.75c0-.414.336-.75.75-.75s.75.336.75.75v10.5c0,.414-.336.75-.75.75Z"/><path d="m10.546,9.375c-.127,0-.256-.032-.375-.101L1.078,4.024c-.359-.207-.481-.666-.274-1.024.207-.359.667-.482,1.024-.274l9.094,5.25c.359.207.481.666.274,1.024-.139.241-.391.375-.65.375Z"/><path d="m1.454,9.375c-.259,0-.511-.134-.65-.375-.207-.359-.084-.817.274-1.024L10.172,2.726c.358-.208.818-.084,1.024.274.207.359.084.817-.274,1.024L1.828,9.274c-.118.068-.247.101-.375.101Z"/></svg>
      <span>{{ content | readingTime }} read</span>
    </div>

    {% if excerpt %}
    <p class="detail__summary">{{ excerpt }}</p>
    {% endif %}
  </header>

  {% if tldr %}
  <aside class="detail__tldr" aria-label="Summary">
    <strong>TL;DR:</strong> {{ tldr | safe }}
  </aside>
  {% endif %}

  <div class="detail__body">
    {{ content | safe }}
  </div>
</article>
